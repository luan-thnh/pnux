{
  "name": "pnux",
  "version": "0.6.0",
  "description": "A compact, safe multi-select port manager for Linux developers",
  "type": "module",
  "bin": {
    "pnux": "./bin/pnux.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "README.vi.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/pnux.js",
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "demo": "node ./bin/pnux.js --list"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux"
  ],
  "license": "MIT",
  "keywords": [
    "port",
    "kill-port",
    "process",
    "linux",
    "tui",
    "cli",
    "development",
    "safe"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luan-thnh/pnux.git"
  },
  "homepage": "https://github.com/luan-thnh/pnux#readme",
  "bugs": {
    "url": "https://github.com/luan-thnh/pnux/issues"
  }
}
